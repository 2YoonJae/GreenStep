# 이 파일을 .env 로 복사해 값을 채웁니다. .env 는 Git·Docker 이미지에 들어가지 않습니다.

# 공공데이터포털 「행정안전부_봉사참여정보서비스_GW」 인증키 (Decoding 키)
SERVICE_KEY=YOUR_API_KEY

# 지역별로 가져올 최신 공고 수 (1~100)
REGION_LIMIT=20
# once: 한 번만 실행 / loop: INTERVAL_SECONDS 마다 반복
RUN_MODE=loop
# 수집 주기 (초). 7200 = 2시간
INTERVAL_SECONDS=7200
# 상세조회 하루 최대 호출 수 (개발계정 한도 1,000 미만으로)
DETAIL_DAILY_BUDGET=900
# 최근 N시간 안에 상세조회한 공고는 다시 조회하지 않음
DETAIL_REFRESH_HOURS=6
# API 호출 사이 대기 (초)
REQUEST_DELAY_SECONDS=0.3
# true: 성인 참여 불가(청소년 전용) 공고는 저장하지 않음
ADULT_ONLY=true

# Docker 밖에서 직접 실행할 때만 사용 (Docker 에서는 docker-compose.yml 이 db 주소를 넣음)
# DATABASE_URL=postgresql://greenstep:greenstep@localhost:5433/greenstep
